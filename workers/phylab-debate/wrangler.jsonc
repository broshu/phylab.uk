{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phylab-debate",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "AI_BASE_URL": "https://api.deepseek.com",
    "AI_MODEL": "deepseek-flash",
    "ALLOWED_ORIGINS": "https://phylab.uk,https://www.phylab.uk,https://preview.phylab.uk"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "phylab-debate-records", "database_id": "0edff5ae-1d72-498d-8f30-9a23cb5aeb05" }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 } }
}
